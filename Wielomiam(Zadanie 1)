#include <iostream>
#include <cstring>
#include <cstdlib>
#include <cmath>
#include <stdexcept>
using namespace std;

class Wielomian
{
private:
    double* wspolczynnik_;
    int stopien_;

    static char* usunOdstepy(const char* napis)
    {
        int dlugosc = (int)strlen(napis);
        char* wynik = new char[dlugosc + 1];
        int j = 0;
        for (int i = 0; i < dlugosc; i++)
            if (napis[i] != ' ')
                wynik[j++] = napis[i];
        wynik[j] = '\0';
        return wynik;
    }

    static int okreslStopien(const char* napis)
    {
        int najwyzszy = 0;
        int i = 0;
        while (napis[i]) {
            if (napis[i] == 'x')
            {
                int stopien = 1;
                if (napis[i + 1] == '^')
                {
                    char* koniec;
                    stopien = (int)strtol(&napis[i + 2], &koniec, 10);
                    i = (int)(koniec - napis);
                }
                else
                {
                    i++;
                }
                if (stopien > najwyzszy)
                    najwyzszy = stopien;
            }
            else
            {
                i++;
            }
        }
        return najwyzszy;
    }

    static double* przydzielPamiec(int stopien)
    {
        double* tab = new double[stopien + 1];
        for (int i = 0; i <= stopien; i++)
            tab[i] = 0.0;
        return tab;
    }

    void dopasujStopien()
    {
        while (stopien_ > 0 && wspolczynnik_[stopien_] == 0.0)
            stopien_--;
    }

    void rozszerzDo(int nowyStopien)
    {
        if (nowyStopien <= stopien_)
            return;
        double* nowa = przydzielPamiec(nowyStopien);
        for (int i = 0; i <= stopien_; i++)
            nowa[i] = wspolczynnik_[i];
        delete[] wspolczynnik_;
        wspolczynnik_ = nowa;
        stopien_ = nowyStopien;
    }

    const char* wczytajJednomian(const char* napis)
    {
        int znak = 1;
        if (*napis == '-') { znak = -1; napis++; }
        else if (*napis == '+') { napis++; }

        double wspolczynnik = 1.0;
        if (*napis != 'x') {
            char* koniec;
            wspolczynnik = strtod(napis, &koniec);
            napis = koniec;
        }

        int wykladnik = 0;
        if (*napis == 'x')
        {
            napis++;
            wykladnik = 1;
            if (*napis == '^')
            {
                char* koniec;
                wykladnik = (int)strtol(napis + 1, &koniec, 10);
                napis = koniec;
            }
        }

        rozszerzDo(wykladnik);
        wspolczynnik_[wykladnik] += znak * wspolczynnik;
        dopasujStopien();
        return napis;
    }

public:
    int stopien() const { return stopien_; }

    Wielomian()
    {
        stopien_ = 0;
        wspolczynnik_ = przydzielPamiec(0);
    }

    Wielomian(const double* tab, int liczba)
    {
        if (liczba <= 0)
        {
            stopien_ = 0;
            wspolczynnik_ = przydzielPamiec(0);
            return;
        }
        stopien_ = liczba - 1;
        wspolczynnik_ = przydzielPamiec(stopien_);
        for (int i = 0; i < liczba; i++)
            wspolczynnik_[i] = tab[i];
        dopasujStopien();
    }

    Wielomian(const char* napis)
    {
        stopien_ = 0;
        wspolczynnik_ = przydzielPamiec(0);
        if (!napis)
            return;
        char* czysty = usunOdstepy(napis);
        const char* p = czysty;
        while (*p) {
            const char* dalej = wczytajJednomian(p);
            if (dalej == p)
                break;
            p = dalej;
        }
        delete[] czysty;
        dopasujStopien();
    }

    Wielomian(const Wielomian& inny)
    {
        stopien_ = inny.stopien_;
        wspolczynnik_ = przydzielPamiec(stopien_);
        for (int i = 0; i <= stopien_; i++)
            wspolczynnik_[i] = inny.wspolczynnik_[i];
    }

    Wielomian& operator=(const Wielomian& inny)
    {
        if (this == &inny)
            return *this;
        double* nowa = przydzielPamiec(inny.stopien_);
        for (int i = 0; i <= inny.stopien_; i++)
            nowa[i] = inny.wspolczynnik_[i];
        delete[] wspolczynnik_;
        wspolczynnik_ = nowa;
        stopien_ = inny.stopien_;
        return *this;
    }

    ~Wielomian() {
        delete[] wspolczynnik_;
    }

    double operator[](int i) const
    {
        if (i < 0)
            throw out_of_range("indeks ujemny");
        if (i > stopien_)
            return 0.0;
        return wspolczynnik_[i];
    }

    Wielomian Pochodna() const
    {
        if (stopien_ == 0)
            return Wielomian();
        Wielomian wynik;
        wynik.rozszerzDo(stopien_ - 1);
        for (int i = 1; i <= stopien_; i++)
            wynik.wspolczynnik_[i - 1] = wspolczynnik_[i] * i;
        wynik.dopasujStopien();
        return wynik;
    }

    double operator()(double x) const
    {
        double wynik = 0.0;
        for (int i = stopien_; i >= 0; i--)
            wynik = wynik * x + wspolczynnik_[i];
        return wynik;
    }

    friend Wielomian operator+(const Wielomian& a, const Wielomian& b)
    {
        int n = max(a.stopien_, b.stopien_);
        Wielomian wynik;
        wynik.rozszerzDo(n);
        for (int i = 0; i <= n; i++)
            wynik.wspolczynnik_[i] = a[i] + b[i];
        wynik.dopasujStopien();
        return wynik;
    }

    friend Wielomian operator-(const Wielomian& a, const Wielomian& b)
    {
        int n = max(a.stopien_, b.stopien_);
        Wielomian wynik;
        wynik.rozszerzDo(n);
        for (int i = 0; i <= n; i++)
            wynik.wspolczynnik_[i] = a[i] - b[i];
        wynik.dopasujStopien();
        return wynik;
    }

    friend Wielomian operator*(const Wielomian& a, const Wielomian& b)
    {
        Wielomian wynik;
        wynik.rozszerzDo(a.stopien_ + b.stopien_);
        for (int i = 0; i <= a.stopien_; i++)
            for (int j = 0; j <= b.stopien_; j++)
                wynik.wspolczynnik_[i + j] += a.wspolczynnik_[i] * b.wspolczynnik_[j];
        wynik.dopasujStopien();
        return wynik;
    }

    friend Wielomian operator/(const Wielomian& a, const Wielomian& b)
    {
        if (b.stopien_ == 0 && b.wspolczynnik_[0] == 0.0)
            throw domain_error("dzielenie przez wielomian zerowy");
        Wielomian reszta(a);
        if (reszta.stopien_ < b.stopien_)
            return Wielomian();
        int stopienIlorazu = reszta.stopien_ - b.stopien_;
        double* iloraz = przydzielPamiec(stopienIlorazu);
        while (reszta.stopien_ >= b.stopien_ &&
               !(reszta.stopien_ == 0 && reszta.wspolczynnik_[0] == 0.0)) {
            int potega = reszta.stopien_ - b.stopien_;
            double czynnik = reszta.wspolczynnik_[reszta.stopien_] / b.wspolczynnik_[b.stopien_];
            iloraz[potega] = czynnik;
            for (int i = 0; i <= b.stopien_; i++)
                reszta.wspolczynnik_[i + potega] -= czynnik * b.wspolczynnik_[i];
            reszta.dopasujStopien();
            if (potega == 0)
                break;
        }
        Wielomian wynik(iloraz, stopienIlorazu + 1);
        delete[] iloraz;
        return wynik;
    }

    friend Wielomian operator*(const Wielomian& a, double liczba)
    {
        Wielomian wynik(a);
        for (int i = 0; i <= wynik.stopien_; i++)
            wynik.wspolczynnik_[i] *= liczba;
        wynik.dopasujStopien();
        return wynik;
    }
    friend Wielomian operator*(double liczba, const Wielomian& a)
    {
        return a * liczba;
    }

    friend Wielomian operator/(const Wielomian& a, double liczba)
    {
        if (liczba == 0.0)
            throw domain_error("dzielenie przez zero");
        Wielomian wynik(a);
        for (int i = 0; i <= wynik.stopien_; i++)
            wynik.wspolczynnik_[i] /= liczba;
        wynik.dopasujStopien();
        return wynik;
    }

    friend Wielomian operator+(const Wielomian& a, double liczba)
    {
        Wielomian wynik(a);
        wynik.wspolczynnik_[0] += liczba;
        wynik.dopasujStopien();
        return wynik;
    }
    friend Wielomian operator+(double liczba, const Wielomian& a)
    {
        return a + liczba;
    }

    friend Wielomian operator-(const Wielomian& a, double liczba)
    {
        Wielomian wynik(a);
        wynik.wspolczynnik_[0] -= liczba;
        wynik.dopasujStopien();
        return wynik;
    }
    friend Wielomian operator-(double liczba, const Wielomian& a)
    {
        Wielomian wynik = (-1.0) * a;
        wynik.wspolczynnik_[0] += liczba;
        wynik.dopasujStopien();
        return wynik;
    }

    friend ostream& operator<<(ostream& os, const Wielomian& w)
    {
        bool pierwszy = true;
        for (int i = w.stopien_; i >= 0; i--)
        {
            double a = w.wspolczynnik_[i];
            if (a == 0.0)
                continue;
            if (pierwszy)
            {
                if (a < 0)
                    os << "-";
            }
            else
            {
                os << (a < 0 ? " - " : " + ");
            }
            pierwszy = false;
            double wartosc = fabs(a);
            if (i == 0) {
                os << wartosc;
            }
            else
            {
                if (wartosc != 1.0)
                    os << wartosc;
                os << "x";
                if (i > 1)
                    os << "^" << i;
            }
        }
        if (pierwszy)
            os << 0;
        return os;
    }

    friend istream& operator>>(istream& is, Wielomian& w)
    {
        string linia;
        if (!getline(is, linia))
            return is;
        w = Wielomian(linia.c_str());
        return is;
    }
};

int main() {
    const char* testy[] =
    {
        "x^3-x^2+2x-7.5",
        "x^2 - 2x + 5",
        "-3.5x - 17.2x^5",
        "x",
        "3.5",
        "-x",
        "0"
    };

    for (const char* napis : testy)
    {
        Wielomian w(napis);
        cout << napis << "   ->   " << w << "\n";
    }

    double a1[] = {7, -2, 0, 3};
    Wielomian p1(a1, 4);
    Wielomian p2("x^2+1");

    cout << "p1: " << p1 << "\n";
    cout << "p2: " << p2 << "\n";

    cout << "p1 + p2 = " << (p1 + p2) << "\n";
    cout << "p1 - p2 = " << (p1 - p2) << "\n";
    cout << "p1 * p2 = " << (p1 * p2) << "\n";
    cout << "p1 + 5 = " << (p1 + 5) << "\n";
    cout << "5 + p2 = " << (5 + p2) << "\n";
    cout << "p1 * 2 = " << (p1 * 2) << "\n";
    cout << "p2 / 2 = " << (p2 / 2) << "\n";

    Wielomian p3("x^3-1");
    Wielomian p4("x-1");
    cout << "(x^3-1)/(x-1) = " << (p3 / p4) << "\n";

    cout << "(p1)' = " << p1.Pochodna() << "\n";

    cout.setf(ios::fixed);
    cout.precision(3);
    cout << "p2(2.5) = " << p2(2.5) << "\n";
    cout << "wsp. przy x^2 w p2: " << p2[2] << "\n";

    cout << "Podaj wielomian (np. 3x^5-2x^2+7): ";
    Wielomian wczytany;
    cin >> wczytany;
    cout << "Wczytano: " << wczytany << "\n";

    return 0;
}
